<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Awizzy.App.ViewModels"
        xmlns:suki="using:SukiUI.Controls"
        x:Class="Awizzy.App.Views.SessionOptionsDialog"
        x:DataType="vm:SessionOptionsDialogViewModel"
        Title="Session options"
        Width="460" SizeToContent="Height" CanResize="False"
        CanFullScreen="False" CanPin="False"
        BackgroundStyle="Flat"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{Binding SessionName}" FontWeight="SemiBold" />
        <StackPanel Spacing="4">
            <TextBlock Text="Profile name" />
            <TextBox Text="{Binding ProfileName}" PlaceholderText="e.g. acme-prod" />
        </StackPanel>
        <CheckBox Content="{Binding ApplyToAccountLabel}" IsChecked="{Binding ApplyProfileToAccount}" />
        <StackPanel Spacing="4">
            <TextBlock Text="Region" />
            <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}"
                      HorizontalAlignment="Stretch" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SukiDangerColor}" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Save" Classes="Flat" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</suki:SukiWindow>
