<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Awizzy.App.ViewModels"
        xmlns:suki="using:SukiUI.Controls"
        x:Class="Awizzy.App.Views.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Title="Settings"
        Width="520" SizeToContent="Height" CanResize="False"
        CanFullScreen="False" CanPin="False"
        BackgroundStyle="Flat"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Refresh margin (minutes before expiry)" />
            <NumericUpDown Value="{Binding RefreshMarginMinutes}" Minimum="1" Maximum="55"
                           Increment="1" FormatString="0" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Credentials file path" />
            <TextBox Text="{Binding CredentialsFilePath}"
                     PlaceholderText="{Binding DefaultCredentialsPath}" />
            <TextBlock Text="Leave empty to use the default shown above. Changing this stops active sessions."
                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Theme" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                      HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,130">
                <CheckBox Grid.Column="0" Content="Enable local MCP server"
                          IsChecked="{Binding McpServerEnabled}" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding McpServerPort}"
                               Minimum="1024" Maximum="65535" Increment="1" FormatString="0"
                               IsEnabled="{Binding McpServerEnabled}" />
            </Grid>
            <TextBlock Text="Lets local AI tools (e.g. Claude Code) list, start, and stop sessions over HTTP on localhost. Any process on this machine can reach it while enabled."
                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel Spacing="4" Margin="0,8,0,0"
                        IsVisible="{Binding HasMcpRoles}" IsEnabled="{Binding McpServerEnabled}">
                <TextBlock Text="Roles excluded from MCP control (still listed, but cannot be started, stopped, or opened in the console):"
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                <Border BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="8,4">
                    <ScrollViewer MaxHeight="140">
                        <ItemsControl ItemsSource="{Binding McpRoles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:McpRoleExclusionViewModel">
                                    <CheckBox IsChecked="{Binding IsExcluded}" Content="{Binding DisplayName}"
                                              FontSize="12" MinHeight="26" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SukiDangerColor}" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Save" Classes="Flat" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</suki:SukiWindow>
