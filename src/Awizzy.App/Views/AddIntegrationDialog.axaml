<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Awizzy.App.ViewModels"
        xmlns:suki="using:SukiUI.Controls"
        x:Class="Awizzy.App.Views.AddIntegrationDialog"
        x:DataType="vm:AddIntegrationDialogViewModel"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height" CanResize="False"
        CanFullScreen="False" CanPin="False"
        BackgroundStyle="Flat"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Name" />
            <TextBox Text="{Binding Alias}" PlaceholderText="e.g. My Company" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="SSO start URL" />
            <TextBox Text="{Binding PortalUrl}" PlaceholderText="https://my-org.awsapps.com/start" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="SSO region" />
            <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}"
                      HorizontalAlignment="Stretch" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SukiDangerColor}" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Save" Classes="Flat" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</suki:SukiWindow>
