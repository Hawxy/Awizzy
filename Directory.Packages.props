<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="SukiUI" Version="7.0.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Hosting / DI -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <!-- AWS -->
    <PackageVersion Include="AWSSDK.SSO" Version="4.0.100.12" />
    <PackageVersion Include="AWSSDK.SSOOIDC" Version="4.0.100.11" />
    <!-- MCP server -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- Core infrastructure -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.2.0" />
    <!-- Logging -->
    <PackageVersion Include="Karambolo.Extensions.Logging.File" Version="4.1.1" />
    <!-- Tests -->
    <PackageVersion Include="TUnit" Version="1.65.51" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
  </ItemGroup>
</Project>
